{
  "name": "paseo-switcher",
  "type": "module",
  "version": "1.1.0",
  "license": "MIT",
  "description": "Ctrl+Tab workspace switching and back/forward navigation through Paseo workspaces, sessions, tabs, plugin pages and Settings.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomgrin10/paseo-switcher.git"
  },
  "homepage": "https://github.com/tomgrin10/paseo-switcher#readme",
  "bugs": "https://github.com/tomgrin10/paseo-switcher/issues",
  "author": "Tom Gringauz",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "workspaces",
    "switcher",
    "keyboard",
    "ctrl-tab"
  ],
  "files": [
    "paseo-plugin.json",
    "assets/",
    "OVERVIEW.md",
    "index.client.tsx",
    "client/",
    "docs/media/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "verify": "npm run typecheck && npm test",
    "e2e": "node test/e2e/run.mjs",
    "e2e:history": "node test/e2e/history.mjs",
    "media": "node test/e2e/media.mjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.15.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/react": "~19.2.0",
    "playwright-core": "^1.58.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
